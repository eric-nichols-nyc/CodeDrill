# Copy to `.env.local` (Next.js) or `.env` and fill in real values.
# https://nextjs.org/docs/app/guides/environment-variables

# Required — hosted Neon Auth instance base URL (absolute HTTPS URL from Neon console).
# Used by `app/api/auth/[...path]/route.ts` and `neonAuth()` / `getNeonAuth()` on the server.
NEON_AUTH_BASE_URL=https://your-neon-auth-instance.example

# Optional — public site URL (defaults to http://localhost:3010 where used).
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional — Nest `neon-jwt-api` origin for `/admin` problem creation (defaults to http://localhost:3030).
# NEON_JWT_API_URL=http://localhost:3030

# Same value as `neon-jwt-api` `INTERNAL_PROBLEMS_SECRET` (min 8 chars). Required for admin problem create
# when the browser uses Neon Auth and does not hold a Better Auth session cookie for the Nest API.
# INTERNAL_PROBLEMS_SECRET=your-long-random-shared-secret

# Optional — test user for local scripts / manual sign-up (matches common Better Auth body shape).
# Do not use real credentials; dev only.
# When set, `/auth/sign-in` and `/auth/sign-up` show a dev-only “Fill form from env” button.
NEON_AUTH_TEST_EMAIL=test@example.com
NEON_AUTH_TEST_PASSWORD=password123
NEON_AUTH_TEST_NAME=Test User
