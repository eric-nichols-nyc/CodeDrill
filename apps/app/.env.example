# Copy to `.env.local` (Next.js) or `.env` and fill in real values.
# https://nextjs.org/docs/app/guides/environment-variables

# -----------------------------------------------------------------------------
# Clerk (required) — https://dashboard.clerk.com
# Also set CLERK_SECRET_KEY on apps/api (same value) for practice BFF JWT verification.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/problems
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/problems

# -----------------------------------------------------------------------------
# App URL (optional)
# Default: http://localhost:3010
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# -----------------------------------------------------------------------------
# Backend APIs (optional — defaults match local monorepo dev)
# -----------------------------------------------------------------------------
# Practice API (`apps/api`) — catalog, progress, chat, admin BFF upstream.
# Default: http://localhost:3030
# NEON_JWT_API_URL=http://localhost:3030

# Identity / profile API (`nest-clerk-api`) — GET /api/me, Clerk user provisioning.
# Default: http://localhost:3031
# NEST_CLERK_API_URL=http://localhost:3031

# -----------------------------------------------------------------------------
# Catalog fallback (optional)
# Server-to-server access to GET /problems without a signed-in user.
# Must match INTERNAL_PROBLEMS_SECRET on apps/api if used. Not needed when signed in.
# -----------------------------------------------------------------------------
# INTERNAL_PROBLEMS_SECRET=your-long-random-shared-secret
