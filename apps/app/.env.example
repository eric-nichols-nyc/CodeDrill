# Copy to `.env.local` (Next.js) or `.env` and fill in real values.
# https://nextjs.org/docs/app/guides/environment-variables

# Optional — public site URL (defaults to http://localhost:3010). Used by auth client base URL on SSR.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional — Nest `neon-jwt-api` origin (defaults to http://localhost:3030).
# Auth is proxied via `/api/auth/*` → `{NEON_JWT_API_URL}/api/auth/*`.
# NEON_JWT_API_URL=http://localhost:3030

# Optional — server-to-server catalog/admin BFF access to `GET/POST /problems` without a user session.
# INTERNAL_PROBLEMS_SECRET=your-long-random-shared-secret

# Optional — OpenAI key for admin “Generate problem from prompt” (`POST /api/admin/problems/generate`).
# OPENAI_API_KEY=sk-...

# Optional — dev autofill on `/auth/sign-in` and `/auth/sign-up` (do not use real credentials).
# AUTH_TEST_EMAIL=test@example.com
# AUTH_TEST_PASSWORD=password123
# AUTH_TEST_NAME=Test User
