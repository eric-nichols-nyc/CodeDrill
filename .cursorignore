# Cursor index exclusions (gitignore syntax)
# https://cursor.com/docs/context/ignore-files

# Monorepo scope — only apps/app, apps/api, packages/design-system
apps/ai-chatbots/
apps/storybook/
apps/system-design-lab/
apps/testing-lab/
apps/with-nest/
apps/with-solid/
apps/with-sse/

packages/ai/
packages/analytics/
packages/auth/
packages/collaboration/
packages/database/
packages/email/
